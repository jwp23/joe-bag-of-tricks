#!/usr/bin/env bash
# SessionStart hook for the joe-bag-of-tricks plugin.
# Injects the using-skills skill at session start so skill discovery happens
# before the first response. Claude Code only.

set -euo pipefail

# Resolve plugin root from this script's own location.
# Splits $0 on its last / with no separator meaning the current directory.
# This avoids dirname because a SessionStart:startup hook can run with a
# broken/empty PATH (anthropics/claude-code#43127) before any PATH-repairing
# sibling hook in the same startup batch takes effect.
case "$0" in
  */*) SCRIPT_DIR="$(cd "${0%/*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-skills via bash's builtin $(< file) instead of cat, for the same
# PATH-independence reason.
skill_md="${PLUGIN_ROOT}/skills/using-skills/SKILL.md"
if [ -r "$skill_md" ]; then
  using_skills_content="$(<"$skill_md")"
else
  using_skills_content="Error reading using-skills skill"
fi

# Escape a string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass — far faster than a char loop.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_skills_escaped=$(escape_for_json "$using_skills_content")
session_context="<using-skills>\nBelow is the full content of your 'joe-bag-of-tricks:using-skills' skill — your introduction to using skills. For all other skills, use the 'Skill' tool:\n\n${using_skills_escaped}\n</using-skills>"

# Claude Code reads hookSpecificOutput.additionalContext.
# printf (not heredoc) avoids the bash 5.3+ heredoc hang (see obra/superpowers#571).
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
